# =============================================================================
# FOLF — variables de despliegue (copiar a .env en la raíz del repo)
# =============================================================================

# PostgreSQL
POSTGRES_USER=folf
POSTGRES_PASSWORD=cambiar-password-seguro
POSTGRES_DB=folf

# Backend (NestJS) — puerto 3000
BACKEND_PORT=3000
DATABASE_URL=postgresql://folf:cambiar-password-seguro@postgres:5432/folf?schema=public
JWT_ACCESS_SECRET=cambiar-access-secret-minimo-32-caracteres
JWT_REFRESH_SECRET=cambiar-refresh-secret-minimo-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend (Vite/React) — puerto 5173 por defecto
FRONTEND_PORT=5173

# CORS (orígenes separados por coma; vacío = permitir todos)
# Ejemplo dev: http://localhost:5173
CORS_ORIGINS=

# Seed inicial (true solo en primer deploy)
RUN_DB_SEED=true

# Credenciales demo del seed (cambiar en producción)
SEED_ADMIN_EMAIL=admin@folf.local
SEED_ADMIN_PASSWORD=CambiarAdmin123!
SEED_OWNER_EMAIL=owner@folf.local
SEED_OWNER_PASSWORD=CambiarOwner123!
SEED_MANAGER_EMAIL=manager@folf.local
SEED_MANAGER_PASSWORD=CambiarManager123!
SEED_WAITER_EMAIL=waiter@folf.local
SEED_WAITER_PASSWORD=CambiarWaiter123!
SEED_COOK_EMAIL=cook@folf.local
SEED_COOK_PASSWORD=CambiarCook123!
SEED_BARTENDER_EMAIL=bartender@folf.local
SEED_BARTENDER_PASSWORD=CambiarBartender123!
SEED_CUSTOMER_EMAIL=customer@folf.local
SEED_CUSTOMER_PASSWORD=CambiarCustomer123!

# Redis (caché + engine de Centrifugo)
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Centrifugo (WebSocket en tiempo real)
CENTRIFUGO_PORT=8000
CENTRIFUGO_API_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=cambiar-centrifugo-api-key
CENTRIFUGO_TOKEN_HMAC_SECRET=cambiar-centrifugo-hmac-secret-minimo-32

# CI/CD — imágenes publicadas por GitHub Actions (push a main → GHCR)
# En el servidor: docker compose --profile prod up -d
# Watchtower revisa GHCR cada WATCHTOWER_POLL_INTERVAL segundos y recrea
# backend/frontend si hay un digest nuevo. Postgres no se actualiza solo.
BACKEND_IMAGE=ghcr.io/nickm4775/golfsportbar-backend:latest
FRONTEND_IMAGE=ghcr.io/nickm4775/golfsportbar-frontend:latest
WATCHTOWER_POLL_INTERVAL=300
# PAT de GitHub con read:packages si los paquetes de GHCR son privados
GHCR_USER=
GHCR_TOKEN=
