# PostgreSQL (coincide con los defaults del compose si no había .env al primer arranque)
POSTGRES_USER=folf
POSTGRES_PASSWORD=folf
POSTGRES_DB=folf

# Backend
DATABASE_URL=postgresql://folf:folf@postgres:5432/folf?schema=public
JWT_ACCESS_SECRET=dev-access-secret-minimo-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-minimo-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000

CORS_ORIGINS=

RUN_DB_SEED=true

SEED_OWNER_EMAIL=owner@folf.local
SEED_OWNER_PASSWORD=Owner123!
SEED_MANAGER_EMAIL=manager@folf.local
SEED_MANAGER_PASSWORD=Manager123!
SEED_WAITER_EMAIL=waiter@folf.local
SEED_WAITER_PASSWORD=Waiter123!
SEED_COOK_EMAIL=cook@folf.local
SEED_COOK_PASSWORD=Cook123!
SEED_BARTENDER_EMAIL=bartender@folf.local
SEED_BARTENDER_PASSWORD=Bartender123!

FRONTEND_PORT=5173
